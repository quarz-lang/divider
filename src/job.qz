# A job: a class whose `enqueue` inserts a row into `divider_jobs`, which
# a worker later runs. The class body sets its
# options with statements that run at compile time:
#
# ```quarz no_run
# class Cleanup < Divider::Job
#   queue :maintenance            # default :default
#   max_attempts 5                # default 20
#   timeout 2.minutes             # default none
#   unique period: 1.hour         # at most one live Cleanup an hour
# end
#
# def schedule(repo: Rotor::Repo) -> Void
#   Cleanup.enqueue(repo)                           # now
#   Cleanup.enqueue(repo, after: 10.minutes)        # in ten minutes, by the database's clock
#   Cleanup.enqueue(repo, at: Time.utc(2026, 12, 1), priority: 1)
# end
# ```
#
# `enqueue` runs in the repository's transaction when it is bound to
# one (`repo.transaction { |tx| ... Cleanup.enqueue(tx) }`): the job
# exists, and a worker hears of it, only once that commits.
abstract class Job
  # The queue (generated by `queue`).
  def self.job_queue -> String = "default"
  # How many attempts before the job is discarded (generated by
  # `max_attempts`).
  def self.job_max_attempts -> Int = 20
  # The time an attempt may take, in milliseconds, or nil for no limit
  # (generated by `timeout`).
  def self.job_timeout_ms -> Int? = nil
  # The uniqueness of the job's rows, or nil (generated by `unique`).
  def self.job_unique -> Unique? = nil

  # The job's queue: a name of letters, digits and `_` (at compile
  # time: an error at the statement otherwise).
  static def self.queue(name: Symbol) -> Void
    q = name.to_s
    raise ArgumentError.new("a queue's name is letters, digits and _, not #{q.inspect}") unless q.match?(/\A[A-Za-z0-9_]{1,64}\z/)
    doc "The queue: `#{q}`."
    def_class_method(:job_queue) { q }
  end

  # How many attempts the job gets before it is discarded: 1 or more.
  static def self.max_attempts(n: Int) -> Void
    raise ArgumentError.new("max_attempts is 1 or more, not #{n}") if n < 1
    doc "How many attempts before the job is discarded: #{n}."
    def_class_method(:job_max_attempts) { n }
  end

  # The time an attempt may take: longer, the attempt is stopped and
  # counts as failed. At least a millisecond.
  static def self.timeout(limit: Duration) -> Void
    ms = limit.to_ms
    raise ArgumentError.new("a timeout is at least 1ms, not #{limit}") if ms < 1
    doc "The time an attempt may take: #{ms}ms."
    def_class_method(:job_timeout_ms) do -> Int?
      ms
    end
  end

  # The job's arguments: the fields of the `data` type `type`, declared
  # in the class (`data Args(user_id: Int, template: String = "welcome")`,
  # then `args Args`), JSON-encoded into the row. Generates
  #
  # - `enqueue(repo:, <the fields>, at:, after:, priority:)`, keywords
  #   only: a field with a default is optional;
  # - `enqueue_args(repo:, args:, at:, after:, priority:)`, with an args
  #   value.
  #
  # A field's class is checked here: `Int`, `Integer`, `Float`,
  # `String`, `Bool`, `Symbol`, `Time`, `Bytes`, `Array`, `Hash`, `Set`,
  # another `data` type of such fields, or a nullable or union one
  # (which `Type#fields` shows as `Object`). Only the outer class is
  # seen (quarz-lang/quarz#401): a nullable or union field and the
  # elements of a collection are not checked here (`Pen?` or
  # `Array[Pen]` passes, and is found when the worker decodes the job);
  # the keywords are typed by those classes only, without type arguments
  # or nullability, while `enqueue_args` checks its value fully against
  # the type. A value the decoding refuses fails the job with
  # `Divider::ArgsError`. A field cannot be named `repo`,
  # `at`, `after` or `priority`, and `args` comes once.
  static def self.args[A](type: Type[A]) -> Void
    fields = type.fields
    raise ArgumentError.new("#{type.name} has no fields: a job without arguments needs no `args`") if fields.empty?
    fields.each do |f|
      if SCHEDULING.include?(f.name)
        raise ArgumentError.new("#{type.name}##{f.name}: a job's argument cannot be named #{f.name}, a keyword of `enqueue`")
      end
      Job.encodable!(f.type, "#{type.name}##{f.name}", 0)
    end
    declared = statement_values[Meta::Field](:divider_args)
    raise ArgumentError.new("#{self.name} declares `args` twice") if declared.size > 0
    fields.each { |f| declared.add(f) }
    scheduling = [Meta::Keyword.new(:at, Time, false, nullable: true),
                  Meta::Keyword.new(:after, Duration, false, nullable: true),
                  Meta::Keyword.new(:priority, Int, false)]
    keywords = [Meta::Keyword.new(:repo, Rotor::Repo, true)] +
               fields.map { |f| Meta::Keyword.new(f.name, f.type, !f.default) } + scheduling
    names = fields.map(&:name)
    doc "Inserts the job with the arguments given (#{names.map { |n| "`#{n}`" }.join(", ")}), due now, at `at`, or `after` from the database's now, with `priority` (0 to 9, 5 by default)."
    def_class_method(:enqueue, keywords: keywords) do |given| -> Enqueued
      values: Hash[String, Object] = {}
      given.each_pair { |k, v| values = values.put(k.to_s, v) unless Job::SCHEDULING.include?(k) }
      Job.insert(self, given, JSON.generate(values))
    end
    args_type = type.as(Type[Object])
    doc "Inserts the job with `args`, due now, at `at`, or `after` from the database's now, with `priority` (0 to 9, 5 by default)."
    def_class_method(:enqueue_args, keywords: [Meta::Keyword.new(:repo, Rotor::Repo, true), Meta::Keyword.new(:args, args_type, true)] + scheduling) do |given| -> Enqueued
      Job.insert(self, given, JSON.generate(given[:args]))
    end
    doc "The class of the job's arguments: `#{type.name}`."
    def_class_method(:job_args_type) do -> Type[Object]?
      args_type
    end
  end

  # The class of the job's arguments, or nil for a job without (generated
  # by `args`).
  def self.job_args_type -> Type[Object]? = nil

  # :nodoc:
  # The keywords `enqueue` takes beside the arguments.
  SCHEDULING = [:repo, :at, :after, :priority]

  # :nodoc:
  # Inserts a job of `cls` with the arguments `json` and the scheduling
  # keywords of `given`.
  def self.insert(cls: Type[Job], given: Hash[Symbol, Object], json: String) -> Enqueued
    repo = given[:repo].as(Rotor::Repo)
    priority = given[:priority]?.as?(Int) || 5
    Queue.insert(repo, Queue::New.new(cls.name, cls.job_queue, json, priority, given[:at]?.as?(Time),
                                      given[:after]?.as?(Duration), cls.job_max_attempts, cls.job_unique))
  end

  # :nodoc:
  # Raises unless a field of the class `t` can be a job's argument
  # (`args`); `path` names it.
  static def self.encodable!(t: Type[Object], path: String, depth: Int) -> Void
    return if ENCODABLE.any? { |e| t == e }
    raise ArgumentError.new("#{path}: nested too deep") if depth > 16
    if t.method?(:with) && t.method?(:to_h) && !t.fields.empty?
      t.fields.each { |f| Job.encodable!(f.type, "#{path}.#{f.name}", depth + 1) }
      return
    end
    raise ArgumentError.new("#{path}: a #{t.name} cannot be a job's argument (Int, Integer, Float, String, Bool, Symbol, Time, Bytes, Array, Hash, Set, nullable ones and data types of those)")
  end

  # :nodoc:
  # The classes a job's argument may have, as `Type#fields` shows them.
  ENCODABLE = [Int, Integer, Float, String, Bool, Symbol, Time, Bytes, Array, Hash, Set, Object]

  # At most one live job (scheduled, available, running, or failed with
  # a retry pending) of the class with the same values of the arguments
  # `by` within each `period` (from the epoch, by the database's clock),
  # or ever without one: `enqueue` gives the existing job's `Enqueued`
  # instead of inserting. Under REPEATABLE READ or SERIALIZABLE, an
  # `enqueue` whose key a transaction committed since the snapshot holds
  # raises PostgreSQL's serialization failure instead: retry the
  # transaction, as for any such conflict.
  # `by` names fields of the job's `args` that have no default (a field
  # left to its default is absent from the row's JSON), so `unique`
  # comes after `args`.
  static def self.unique(*, by: Array[Symbol] = [], period: Duration? = nil) -> Void
    ms = period&.to_ms
    raise ArgumentError.new("a unique period is at least 1s, not #{period}") if ms && ms < 1000
    raise ArgumentError.new("unique names an argument twice: #{by.inspect}") if by.uniq.size != by.size
    declared = statement_values[Meta::Field](:divider_args).values
    by.each do |n|
      f = declared.find { |d| d.name == n }
      raise ArgumentError.new("unique by: #{self.name} has no argument #{n} (`args` comes first)") if f.nil?
      raise ArgumentError.new("unique by: the argument #{n} has a default, so it may be absent from a job's row: name arguments without one") if f.default
    end
    u = Unique.new(by.map(&:to_s).sort, ms)
    doc "The job's uniqueness."
    def_class_method(:job_unique) do -> Unique?
      u
    end
  end

  # Inserts the job, due now, at `at`, or `after` from the database's
  # now (not both), with `priority` (0, the first, to 9; 5 by default).
  # For a job without arguments: one with `args` takes them as keywords
  # (`enqueue(repo: repo, user_id: 42)`), and calling this form on it
  # (which `enqueue(repo: repo)` without its arguments also resolves to)
  # raises `ArgumentError`.
  def self.enqueue(repo: Rotor::Repo, *, at: Time? = nil, after: Duration? = nil, priority: Int = 5) -> Enqueued
    if t = job_args_type
      raise ArgumentError.new("#{name}.enqueue takes its arguments (#{t.name}) as keywords, or an #{t.name} with enqueue_args")
    end
    Queue.insert(repo, Queue::New.new(name, job_queue, "{}", priority, at, after, job_max_attempts, job_unique))
  end
end

# A job's uniqueness: the names of the arguments that make two jobs the
# same (sorted), and the period in milliseconds (nil: no period).
data Unique = (by: Array[String], period_ms: Int?)

# A job `enqueue` inserted, or the live job it found in its place
# (`unique`): its id, its state (`:scheduled` or `:available`, or
# `:running` or `:failed` for one found) and when it is due.
data Enqueued = (id: Int, state: Symbol, scheduled_at: Time)

# Cancels the job `id`: one scheduled, available or failed (a retry
# pending) becomes `cancelled` (`:cancelled`); a running one is asked to
# stop (`:requested`: its `cancelled_at` is set, which the job sees as
# `cancel_requested?`; it ends `completed` if it finishes anyway,
# `cancelled` otherwise, not retried; asked again, `:requested` again,
# the first request's time kept). Nil for a job that does not exist or
# has ended.
public def cancel(repo: Rotor::Repo, id: Int) -> Symbol?
  states = repo.query("UPDATE divider_jobs SET state = CASE WHEN state = 'running' THEN state ELSE 'cancelled' END, " +
                      "cancelled_at = CASE WHEN state = 'running' THEN COALESCE(cancelled_at, now()) ELSE now() END " +
                      "WHERE id = $1 AND state IN ('scheduled', 'available', 'failed', 'running') RETURNING state", [id]) { |r| r.string(0) }
  s = states.first?
  return nil if s.nil?
  s == "running" ? :requested : :cancelled
end
