# A job: a class whose `enqueue` inserts a row into `divider_jobs`, which
# a worker later runs. The class body sets its
# options with statements that run at compile time:
#
# ```quarz no_run
# class Cleanup < Divider::Job
#   queue :maintenance            # default :default
#   max_attempts 5                # default 20
#   timeout 2.minutes             # default none
#   unique period: 1.hour         # at most one live Cleanup an hour
# end
#
# def schedule(repo: Rotor::Repo) -> Void
#   Cleanup.enqueue(repo)                           # now
#   Cleanup.enqueue(repo, after: 10.minutes)        # in ten minutes, by the database's clock
#   Cleanup.enqueue(repo, at: Time.utc(2026, 12, 1), priority: 1)
# end
# ```
#
# `enqueue` runs in the repository's transaction when it is bound to
# one (`repo.transaction { |tx| ... Cleanup.enqueue(tx) }`): the job
# exists, and a worker hears of it, only once that commits.
abstract class Job
  # Runs the job: what a job without `job_args` defines, with what the worker
  # tells of the attempt (`job.repo` for its queries). Returning ends the
  # job `completed`; [Divider::Discard] discards it, [Divider::Snooze]
  # puts it off, any other exception fails the attempt.
  def perform(job: Context) -> Void
    raise NotImplementedError.new("#{self.class.name} defines no `perform(job: Divider::Context)`")
  end

  # :nodoc:
  # An instance for an attempt of a job without a factory
  # ([Divider.factory]): `new`.
  def self.new_job -> Job = new

  # Says that the class is made by its factory ([Divider.factory]), not
  # with `new`. Unnecessary for a job none of whose `initialize`s can be
  # called without arguments: [inherited] declares it for such a class.
  # Kept for the bodies that have it, and needed by a job whose only
  # `initialize`s that take no arguments require a block (which
  # [Type#constructors] cannot tell): without it, the checker refuses such
  # an `initialize`, as `new_job` calls `new` without a block. A worker
  # (and `Divider::Testing.drain`) given the class in `jobs:` without its
  # factory raises [ArgumentError] when it is made. `Job` makes the other
  # jobs with `new` in a class method they inherit, which the language
  # allows only for a subclass whose `new` takes no argument, or that
  # overrides the method, as this does: without it, the checker refuses
  # the class's `initialize` ("does not take the arguments of `new` in
  # `Divider::Job.new_job`"). It comes once in a class; a subclass of the
  # class inherits it.
  static def self.needs_factory -> Void
    declared = statement_values[String](:divider_needs_factory)
    raise ArgumentError.new("#{self.name} declares `needs_factory` twice") if declared.size > 0
    declared.add(self.name)
    Job.needs_factory!(self)
  end

  # Declares [needs_factory] for a job that does not write it, when `new`
  # cannot make the class without arguments (it has constructors, and
  # none has every parameter optional) and the class does not inherit
  # the declaration already. It never takes the declaration away: a
  # subclass of a job made by a factory stays one, whatever its own
  # `initialize` takes.
  static def self.inherited -> Void
    return if statement_values[String](:divider_needs_factory).size > 0
    return if job_needs_factory
    ctors = constructors
    return if ctors.empty? || ctors.any? { |c| c.params.all?(&:default) }
    Job.needs_factory!(self)
  end

  # :nodoc:
  # Generates what [needs_factory] declares in `cls`.
  static def self.needs_factory![T <: Job](cls: Meta::ClassDef[T]) -> Void
    cls.doc ":nodoc:"
    cls.def_class_method(:new_job, override: true) do -> Job
      raise ArgumentError.new("#{name} needs a factory, and none is given")
    end
    cls.doc "Whether the class needs a factory: it does."
    cls.def_class_method(:job_needs_factory, override: true) { true }
  end

  # Whether the class needs a factory (generated by `needs_factory`, or
  # for a class whose `new` takes arguments).
  def self.job_needs_factory -> Bool = false

  # :nodoc:
  # Runs `perform` (`job_args` generates the one that decodes the arguments
  # and gives them to `perform(args, job)`).
  def run_with(job: Context, args: String) -> Void
    perform(job)
  end

  # The queue (generated by `queue`).
  def self.job_queue -> String = "default"
  # How many attempts before the job is discarded (generated by
  # `max_attempts`).
  def self.job_max_attempts -> Int = 20
  # The time an attempt may take, in milliseconds, or nil for no limit
  # (generated by `timeout`).
  def self.job_timeout_ms -> Int? = nil
  # The uniqueness of the job's rows, or nil (generated by `unique`).
  def self.job_unique -> Unique? = nil

  # The delay before the next attempt after attempt `attempt` (1 for the
  # first) failed with `error`, asked for a failed attempt that is not
  # the last (`max_attempts`). By default `attempt ** 4 + 15` seconds
  # plus a random 0 to 30. A job defines its own:
  #
  # ```quarz no_run
  # class Sync < Divider::Job
  #   def self.retry_in(attempt: Int, error: Exception) -> Duration
  #     [10.seconds, 1.minute, 10.minutes][attempt - 1]? || 30.minutes
  #   end
  # end
  # ```
  #
  # The attempt still counts toward `max_attempts`, and its error is
  # recorded. A negative delay counts as zero. If the hook raises, the
  # default delay is used, and the hook's error is written to standard
  # error and given to the worker's `on_error` (with the attempt's
  # context, after the job's own error). The worker calls it as soon as
  # the attempt fails, so it should return at once.
  def self.retry_in(attempt: Int, error: Exception) -> Duration = Worker.backoff(attempt).ms

  # The job's queue: a name of letters, digits and `_` (at compile
  # time: an error at the statement otherwise).
  static def self.queue(name: Symbol) -> Void
    q = name.to_s
    raise ArgumentError.new("a queue's name is letters, digits and _, not #{q.inspect}") unless q.match?(/\A[A-Za-z0-9_]{1,64}\z/)
    doc "The queue: `#{q}`."
    def_class_method(:job_queue, override: true) { q }
  end

  # How many attempts the job gets before it is discarded: 1 or more.
  static def self.max_attempts(n: Int) -> Void
    raise ArgumentError.new("max_attempts is 1 or more, not #{n}") if n < 1
    doc "How many attempts before the job is discarded: #{n}."
    def_class_method(:job_max_attempts, override: true) { n }
  end

  # The time an attempt may take: longer, the attempt is stopped and
  # counts as failed. At least a millisecond.
  static def self.timeout(limit: Duration) -> Void
    ms = limit.to_ms
    raise ArgumentError.new("a timeout is at least 1ms, not #{limit}") if ms < 1
    doc "The time an attempt may take: #{ms}ms."
    def_class_method(:job_timeout_ms, override: true) do -> Int?
      ms
    end
  end

  # The job's arguments: the fields of the `data` type `type`, declared
  # in the class (`data Args(user_id: Int, template: String = "welcome")`,
  # then `job_args Args`), JSON-encoded into the row. Generates
  #
  # - `enqueue(repo:, <the fields>, at:, after:, priority:)`, keywords
  #   only: a field with a default is optional;
  # - `enqueue_args(repo:, args:, at:, after:, priority:)`, with an args
  #   value;
  # - `enqueue_all(repo:, args:, at:, after:, priority:)`, with an array
  #   of args values: one job each, inserted with one statement, the
  #   scheduling the same for all. It gives the jobs in the order of
  #   `args`: with `unique`, the live job of a key instead of a new one,
  #   also when two values of one call have the same key; an empty array
  #   inserts nothing. The queue is notified once.
  #
  # The args type cannot have type parameters: a generic `data` type
  # (`job_args Boxed[Int]`, or an alias of it) is refused, as a `Type`
  # value does not say its fields' types; a field of a generic type with
  # its arguments written (`inner: Inner[Int]`, `ids: Array[Int]`) is
  # fine (divider#50).
  #
  # A field's class is checked here: [Int], [Integer], [Float],
  # [String], [Bool], [Symbol], [Time], [Bytes], [Array], [Hash], [Set],
  # another `data` type of such fields, or a nullable or union one
  # (which [Type#fields] shows as [Object]). Only the outer class is
  # checked here: a nullable or union field and the elements of a
  # collection are not (`Pen?` or `Array[Pen]` passes, and is found when
  # the worker decodes the job). The keywords are typed by the fields'
  # declared types in full ([Meta::Field#type_ref]: `ids: Array[Int]`,
  # `note: String?`), and `enqueue_all`'s `args:` as an [Array] of the
  # type, so a call with a value of another type does not compile. The
  # worker decodes the stored arguments ([JSON.decode]) and
  # calls `perform(args, job)`; arguments that do not decode discard the
  # job with [Divider::ArgsError], which names where and what was expected (not
  # the value found: it may be a secret). A field cannot be
  # named `repo`, `at`, `after` or `priority`, and `job_args` comes once.
  static def self.job_args[A](type: Type[A]) -> Void
    perform = method_ref[(A, Context) -> Void](:perform)
    fields = type.fields
    raise ArgumentError.new("#{type.name} has no fields: a job without arguments needs no `job_args`") if fields.empty?
    # (A generic data type: its fields' types are its parameters, which a
    # `Type` value does not say for `Boxed[Int]` (divider#50).)
    params: Array[Symbol] = []
    fields.each { |f| params = Job.params_of(f.type_ref, type, params) }
    unless params.empty?
      raise ArgumentError.new("#{self.name}: the args type #{type.name} has type parameters (#{params.join(", ")}), which a job's " +
                              "arguments cannot have: write a data type with the fields' types spelled out")
    end
    fields.each do |f|
      if SCHEDULING.include?(f.name)
        raise ArgumentError.new("#{type.name}##{f.name}: a job's argument cannot be named #{f.name}, a keyword of `enqueue`")
      end
      Job.encodable!(f.type, "#{type.name}##{f.name}", 0)
    end
    declared = statement_values[Meta::Field](:divider_args)
    raise ArgumentError.new("#{self.name} declares `job_args` twice") if declared.size > 0
    # (An ancestor's `job_args` generated this marker: its `enqueue`,
    # `unique` and arguments are this class's too.)
    if method?(:__divider_job_args)
      raise ArgumentError.new("#{self.name} inherits the arguments of a job with `job_args`: a subclass cannot declare others")
    end
    doc ":nodoc:"
    def_method(:__divider_job_args) { true }
    fields.each { |f| declared.add(f) }
    scheduling = [Meta::Keyword.new(:at, Time, false, nullable: true),
                  Meta::Keyword.new(:after, Duration, false, nullable: true),
                  Meta::Keyword.new(:priority, Int, false)]
    keywords = [Meta::Keyword.new(:repo, Rotor::Repo, true)] +
               fields.map { |f| Job.keyword(f) } + scheduling
    names = fields.map(&:name)
    doc "Inserts the job with the arguments given (#{names.map { |n| "`#{n}`" }.join(", ")}), due now, at `at`, or `after` from the database's now, with `priority` (0 to 9, 5 by default)."
    def_class_method(:enqueue, keywords: keywords) do |given| -> Enqueued
      values: Hash[String, Object] = {}
      given.each_pair { |k, v| values = values.put(k.to_s, v) unless Job::SCHEDULING.include?(k) }
      Job.insert(self, given, JSON.generate(values))
    end
    args_type = type.as(Type[Object])
    doc "Inserts the job with `args`, due now, at `at`, or `after` from the database's now, with `priority` (0 to 9, 5 by default)."
    def_class_method(:enqueue_args, keywords: [Meta::Keyword.new(:repo, Rotor::Repo, true), Meta::Keyword.new(:args, args_type, true)] + scheduling) do |given| -> Enqueued
      Job.insert(self, given, JSON.generate(given[:args]))
    end
    doc "Inserts a job for each of `args` (`#{type.name}` values), with one statement, due now, at `at`, or `after` from the database's now, with `priority` (0 to 9, 5 by default), and gives them in the order of `args` (with `unique`, a key's live job instead of a new one)."
    all_args = Meta::Keyword.typed(:args, Meta::TypeRef.of(Array, [Meta::TypeRef.of(args_type)]), true)
    def_class_method(:enqueue_all, keywords: [Meta::Keyword.new(:repo, Rotor::Repo, true), all_args] + scheduling) do |given| -> Array[Enqueued]
      Job.insert_all(self, given)
    end
    doc "The class of the job's arguments: `#{type.name}`."
    def_class_method(:job_args_type, override: true) do -> Type[Object]?
      args_type
    end
    type_name = type.name
    doc ":nodoc:"
    def_method(:run_with, [:job, :args], override: true) do |job: Context, text: String| -> Void
      decoded = begin
        JSON.decode[A](text)
      rescue JSON::DecodeError => e
        raise ArgsError.new("the stored arguments do not fit #{type_name}: #{Job.without_value(e.message)}")
      end
      perform.bind(self).call(decoded, job)
    end
  end

  # What [JSON::DecodeError]'s message says of where the stored arguments
  # do not fit and what was expected, without the value it found
  # (`$.token: expected an integer that fits an Int, found "..."`): the
  # message goes to logs, `on_error`, events and the row's `errors`, and
  # an argument may be a secret. A message that is not of that form (a
  # decoder's own, as for a decimal past its limit) keeps its path only.
  #
  # :nodoc:
  def self.without_value(message: String) -> String
    head, found, _ = message.partition(", found ")
    return head unless found.empty?
    return message if message.include?(": missing field `")
    message.partition(": ")[0]
  end

  # The class of the job's arguments, or nil for a job without (generated
  # by `job_args`).
  def self.job_args_type -> Type[Object]? = nil

  # :nodoc:
  # `found` with the names of `owner`'s type parameters `r` mentions, at
  # any depth, added once each.
  static def self.params_of(r: Meta::TypeRef, owner: Type[Object], found: Array[Symbol]) -> Array[Symbol]
    case r
    in Meta::TypeRef::Param(owner: o, name:)
      o == owner && !found.include?(name) ? found.push(name) : found
    in Meta::TypeRef::Of(args:)
      out = found
      args.each { |a| out = Job.params_of(a, owner, out) }
      out
    in Meta::TypeRef::Union(members:)
      out = found
      members.each { |m| out = Job.params_of(m, owner, out) }
      out
    else found
    end
  end

  # :nodoc:
  # `enqueue`'s keyword for the field `f`, typed by the field's declared
  # type in full (`Array[Int]`, `String?`), optional when it has a
  # default.
  static def self.keyword(f: Meta::Field) -> Meta::Keyword = Meta::Keyword.typed(f.name, f.type_ref, !f.default)

  # :nodoc:
  # The keywords `enqueue` takes beside the arguments.
  SCHEDULING = [:repo, :at, :after, :priority]

  # :nodoc:
  # Inserts a job of `cls` with the arguments `json` and the scheduling
  # keywords of `given`.
  def self.insert(cls: Type[Job], given: Hash[Symbol, Object], json: String) -> Enqueued
    repo = given[:repo].as(Rotor::Repo)
    priority = given[:priority]?.as?(Int) || 5
    Queue.insert(repo, Queue::New.new(cls.name, cls.job_queue, json, priority, given[:at]?.as?(Time),
                                      given[:after]?.as?(Duration), cls.job_max_attempts, cls.job_unique, cls))
  end

  # :nodoc:
  # Inserts a job of `cls` for each element of `given[:args]` (an array of
  # its args values) with the scheduling keywords of `given`.
  def self.insert_all(cls: Type[Job], given: Hash[Symbol, Object]) -> Array[Enqueued]
    repo = given[:repo].as(Rotor::Repo)
    priority = given[:priority]?.as?(Int) || 5
    # (`args:` is an `Array` of the job's args type: the call was
    # checked so.)
    list = given[:args].as(Array[Object])
    texts = list.map { |x| JSON.generate(x) }
    job = Queue::New.new(cls.name, cls.job_queue, "{}", priority, given[:at]?.as?(Time), given[:after]?.as?(Duration),
                         cls.job_max_attempts, cls.job_unique, cls)
    Queue.insert_all(repo, job, texts)
  end

  # :nodoc:
  # Raises unless a field of the class `t` can be a job's argument
  # (`job_args`); `path` names it.
  static def self.encodable!(t: Type[Object], path: String, depth: Int) -> Void
    return if ENCODABLE.any? { |e| t == e }
    raise ArgumentError.new("#{path}: nested too deep") if depth > 16
    if t.method?(:with) && t.method?(:to_h) && !t.fields.empty?
      t.fields.each { |f| Job.encodable!(f.type, "#{path}.#{f.name}", depth + 1) }
      return
    end
    raise ArgumentError.new("#{path}: a #{t.name} cannot be a job's argument (Int, Integer, Float, String, Bool, Symbol, Time, Bytes, Array, Hash, Set, nullable ones and data types of those)")
  end

  # :nodoc:
  # The classes a job's argument may have, as `Type#fields` shows them.
  ENCODABLE = [Int, Integer, Float, String, Bool, Symbol, Time, Bytes, Array, Hash, Set, Object]

  # At most one live job (scheduled, available, running, or failed with
  # a retry pending) of the class with the same values of the arguments
  # `by` within each `period` (from the epoch, by the database's clock),
  # or ever without one: `enqueue` gives the existing job's [Enqueued]
  # instead of inserting. Under REPEATABLE READ or SERIALIZABLE, an
  # `enqueue` whose key a transaction committed since the snapshot holds
  # raises PostgreSQL's serialization failure instead: retry the
  # transaction, as for any such conflict.
  # `by` names fields of the job's `job_args` that have no default (a field
  # left to its default is absent from the row's JSON), so `unique`
  # comes after `job_args`.
  static def self.unique(*, by: Array[Symbol] = [], period: Duration? = nil) -> Void
    ms = period&.to_ms
    raise ArgumentError.new("a unique period is at least 1s, not #{period}") if ms && ms < 1000
    raise ArgumentError.new("unique names an argument twice: #{by.inspect}") if by.uniq.size != by.size
    declared = statement_values[Meta::Field](:divider_args).values
    by.each do |n|
      f = declared.find { |d| d.name == n }
      raise ArgumentError.new("unique by: #{self.name} has no argument #{n} (`job_args` comes first)") if f.nil?
      raise ArgumentError.new("unique by: the argument #{n} has a default, so it may be absent from a job's row: name arguments without one") if f.default
    end
    u = Unique.new(by.map(&:to_s).sort, ms)
    doc "The job's uniqueness."
    def_class_method(:job_unique, override: true) do -> Unique?
      u
    end
  end

  # Inserts the job, due now, at `at`, or `after` from the database's
  # now (not both), with `priority` (0, the first, to 9; 5 by default).
  # For a job without arguments: one with `job_args` takes them as keywords
  # (`enqueue(repo: repo, user_id: 42)`), and calling this form on it
  # (which `enqueue(repo: repo)` without its arguments also resolves to)
  # raises [ArgumentError].
  def self.enqueue(repo: Rotor::Repo, *, at: Time? = nil, after: Duration? = nil, priority: Int = 5) -> Enqueued
    if t = job_args_type
      raise ArgumentError.new("#{name}.enqueue takes its arguments (#{t.name}) as keywords, or a #{t.name} value with enqueue_args")
    end
    Queue.insert(repo, Queue::New.new(name, job_queue, "{}", priority, at, after, job_max_attempts, job_unique, self))
  end
end

# A job's uniqueness: the names of the arguments that make two jobs the
# same (sorted), and the period in milliseconds (nil: no period).
data Unique = (by: Array[String], period_ms: Int?)

# A job `enqueue` inserted, or the live job it found in its place
# (`unique`): its id, its state (`:scheduled` or `:available`, or
# `:running` or `:failed` for one found) and when it is due.
data Enqueued = (id: Int, state: Symbol, scheduled_at: Time)

# Cancels the job `id`: one scheduled, available or failed (a retry
# pending) becomes `cancelled` (`:cancelled`); a running one is asked to
# stop (`:requested`: its `cancelled_at` is set, which the job sees as
# `cancel_requested?`; it ends `completed` if it finishes anyway,
# `cancelled` otherwise, not retried; asked again, `:requested` again,
# the first request's time kept). Nil for a job that does not exist or
# has ended.
public def cancel(repo: Rotor::Repo, id: Int) -> Symbol?
  states = repo.query("UPDATE divider_jobs SET state = CASE WHEN state = 'running' THEN state ELSE 'cancelled' END, " +
                      "cancelled_at = CASE WHEN state = 'running' THEN COALESCE(cancelled_at, now()) ELSE now() END " +
                      "WHERE id = $1 AND state IN ('scheduled', 'available', 'failed', 'running') RETURNING state", [id]) { |r| r.string(0) }
  s = states.first?
  return nil if s.nil?
  s == "running" ? :requested : :cancelled
end
