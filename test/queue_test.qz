require "test"

class QtPlain < Divider::Job
end

class QtMail < Divider::Job
  queue :mail
  max_attempts 3
  timeout 90.seconds
end

class QtOnce < Divider::Job
  unique
end

class QtHourly < Divider::Job
  unique period: 1.hour
end

class QtBatch < Divider::Job
  queue :mail
  data Args = (n: Int)
  job_args Args
  def perform(args: Args, job: Divider::Context) -> Void
  end
end

class QtBatchOnce < Divider::Job
  data Args = (n: Int, tag: String)
  job_args Args
  unique by: [:n]
  def perform(args: Args, job: Divider::Context) -> Void
  end
end

# The schema, enqueue (scheduling, priority, the notification at commit,
# uniqueness) and cancel, against a server (`PG::Testing`).
class QueueTest < Test::Case
  # (PG_TEST_URL's server is shared and kept between runs: the table is
  # dropped before and after.)
  def with_repo(&: (Rotor::Repo, String) -> Void) -> Void
    PG::Testing.with_cluster do |url|
      PG::Pool.open(url, 2) do |pool|
        repo = Rotor::Repo.new(pool: pool)
        QueueTest.reset(repo)
        begin
          Rotor::Migrator.new(repo, Divider::Migrations.all, table: "divider_test_versions").migrate
          yield repo, url
        ensure
          QueueTest.reset(repo)
        end
      end
    end
  rescue PG::Testing::Unavailable => e
    omit(e.message)
  end

  def self.reset(repo: Rotor::Repo) -> Void
    repo.exec("DROP TABLE IF EXISTS divider_jobs, divider_cron, divider_test_versions")
  end

  # The job `id`'s columns, as text.
  def row(repo: Rotor::Repo, id: Int) -> Hash[String, String?]
    cols = ["class", "queue", "args", "priority", "state", "attempt", "max_attempts", "unique_key"]
    rows = repo.query("SELECT #{cols.map { |c| "#{c}::text" }.join(", ")} FROM divider_jobs WHERE id = $1", [id]) do |r|
      h: Hash[String, String?] = {}
      cols.each_with_index { |c, i| h = h.put(c, r.string?(i)) }
      h
    end
    rows[0]
  end

  def count(repo: Rotor::Repo) -> Int = repo.query("SELECT count(*) FROM divider_jobs") { |r| r.int(0) }[0]

  def test_options
    assert_equal("default", QtPlain.job_queue)
    assert_equal(20, QtPlain.job_max_attempts)
    assert_nil(QtPlain.job_timeout_ms)
    assert_nil(QtPlain.job_unique)
    assert_equal("mail", QtMail.job_queue)
    assert_equal(3, QtMail.job_max_attempts)
    assert_equal(90_000, QtMail.job_timeout_ms)
    assert_equal(Divider::Unique.new([], nil), QtOnce.job_unique)
    assert_equal(Divider::Unique.new([], 3_600_000), QtHourly.job_unique)
  end

  def test_schema_migrates_both_ways
    with_repo do |repo, _|
      cols = repo.query("SELECT column_name FROM information_schema.columns WHERE table_name = 'divider_jobs' ORDER BY ordinal_position") { |r| r.string(0) }
      assert_equal(["id", "class", "queue", "args", "priority", "state", "scheduled_at", "attempt", "max_attempts", "unique_key",
                    "errors", "node", "locked_at", "inserted_at", "completed_at", "discarded_at", "cancelled_at", "trace"], cols)
      indexes = repo.query("SELECT indexname FROM pg_indexes WHERE tablename = 'divider_jobs' ORDER BY indexname") { |r| r.string(0) }
      assert_equal(["divider_jobs_fetch", "divider_jobs_locked", "divider_jobs_pkey", "divider_jobs_prune", "divider_jobs_unique"], indexes)
      # The constraints hold.
      assert_raise(PG::Error) { repo.exec("INSERT INTO divider_jobs (class, queue, state) VALUES ('X', 'q', 'lost')") }
      assert_raise(PG::Error) { repo.exec("INSERT INTO divider_jobs (class, queue, priority) VALUES ('X', 'q', 10)") }
      m = Rotor::Migrator.new(repo, Divider::Migrations.all, table: "divider_test_versions")
      assert_equal([20261108000003, 20261108000002, 20261108000001], m.rollback(steps: 3))
      assert_equal(0, repo.query("SELECT count(*) FROM information_schema.tables WHERE table_name = 'divider_jobs'") { |r| r.int(0) }[0])
    end
  end

  # divider#54: the trace column, NULL until divider reports to Trace; a
  # database without its migration is told which one to run, at an
  # enqueue (one job and several) and when a worker starts.
  def test_trace_column_and_its_missing_migration
    with_repo do |repo, url|
      e = QtMail.enqueue(repo)
      assert_nil(repo.query("SELECT trace::text FROM divider_jobs WHERE id = $1", [e.id]) { |r| r.string?(0) }[0])
      QtBatch.enqueue_all(repo: repo, args: [QtBatch::Args.new(1)])
      assert_equal(0, repo.query("SELECT count(*) FROM divider_jobs WHERE trace IS NOT NULL") { |r| r.int(0) }[0])
      # Rolled back to before the migration: rows inserted before it are kept.
      m = Rotor::Migrator.new(repo, Divider::Migrations.all, table: "divider_test_versions")
      assert_equal([20261108000003], m.rollback(steps: 1))
      [-> { QtMail.enqueue(repo); nil }, -> { QtBatch.enqueue_all(repo: repo, args: [QtBatch::Args.new(2)]); nil }].each do |f|
        err = assert_raise(Divider::Error) { f.call }
        assert_match(/run divider's migration 20261108000003 \(AddTrace/, err.message)
      end
      w = Divider::Worker.new(url, jobs: [QtMail], queues: {mail: 1}, node: "trace-check")
      err = assert_raise(Divider::Error) { w.run }
      assert_match(/migration 20261108000003/, err.message)
      # Migrated again: old rows read NULL, and enqueueing works.
      m.migrate
      assert_equal(2, repo.query("SELECT count(*) FROM divider_jobs WHERE trace IS NULL") { |r| r.int(0) }[0])
      QtMail.enqueue(repo)
    end
  end

  # The worker's check resolves the table along the search path, as its
  # statements do: tables in the second schema of `app, jobs` are found;
  # no table on the path, and no `trace` column, are each told apart.
  def test_schema_check_follows_the_search_path
    with_repo do |repo, url|
      sep = url.include?("?") ? "&" : "?"
      at = ->(path: String) { "#{url}#{sep}options=#{URI.encode_component("-c search_path=#{path}")}" }
      repo.exec("DROP SCHEMA IF EXISTS qt_app, qt_jobs CASCADE")
      repo.exec("CREATE SCHEMA qt_app")
      repo.exec("CREATE SCHEMA qt_jobs")
      begin
        PG::Pool.open(at.call("qt_jobs"), 1) do |pool|
          jobs = Rotor::Repo.new(pool: pool)
          Rotor::Migrator.new(jobs, Divider::Migrations.all, table: "divider_sp_versions").migrate
        end
        Divider::Worker.new(at.call("qt_app,qt_jobs"), jobs: [QtMail], queues: {mail: 1}, node: "sp").check_schema
        e = assert_raise(Divider::Error) { Divider::Worker.new(at.call("qt_app"), jobs: [QtMail], queues: {mail: 1}, node: "sp").check_schema }
        assert_match(/no table divider_jobs on the search path/, e.message)
        repo.exec("ALTER TABLE qt_jobs.divider_jobs DROP COLUMN trace")
        e = assert_raise(Divider::Error) { Divider::Worker.new(at.call("qt_app,qt_jobs"), jobs: [QtMail], queues: {mail: 1}, node: "sp").check_schema }
        assert_match(/migration 20261108000003/, e.message)
      ensure
        repo.exec("DROP SCHEMA IF EXISTS qt_app, qt_jobs CASCADE")
      end
    end
  end

  def test_enqueue_now_and_later
    with_repo do |repo, _|
      e = QtMail.enqueue(repo)
      assert_equal(:available, e.state)
      assert_equal({"class" => "QtMail", "queue" => "mail", "args" => "{}", "priority" => "5", "state" => "available",
                    "attempt" => "0", "max_attempts" => "3", "unique_key" => nil}, row(repo, e.id))
      later = QtPlain.enqueue(repo, after: 1.hour, priority: 0)
      assert_equal(:scheduled, later.state)
      assert_true(later.scheduled_at > e.scheduled_at + 59.minutes)
      assert_equal("0", row(repo, later.id)["priority"])
      at = Time.utc(2030, 1, 2, 3, 4, 5)
      fixed = QtPlain.enqueue(repo, at: at)
      assert_equal([:scheduled, at], [fixed.state, fixed.scheduled_at])
      past = QtPlain.enqueue(repo, at: Time.utc(2020, 1, 1))
      assert_equal(:available, past.state)
      assert_raise(ArgumentError) { QtPlain.enqueue(repo, at: at, after: 1.minute) }
      assert_raise(ArgumentError) { QtPlain.enqueue(repo, priority: 10) }
      assert_raise(ArgumentError) { QtPlain.enqueue(repo, priority: -1) }
      assert_raise(ArgumentError) { QtPlain.enqueue(repo, after: 0.seconds - 1.second) }
      assert_equal(4, count(repo))
    end
  end

  def test_notification_at_commit_and_none_after_rollback
    with_repo do |repo, url|
      listener = PG.connect(url)
      begin
        listener.listen("divider")
        repo.transaction do |tx|
          QtMail.enqueue(tx)
          # (Not before the commit.)
          assert_nil(listener.wait_for_notify(timeout: 200.ms))
        end
        n = listener.wait_for_notify(timeout: 5.seconds)
        assert_equal(Divider::Queue::CHANNEL, n&.channel)
        assert_equal("mail", n&.payload)
        # A scheduled job: no notification (the workers poll for it).
        QtMail.enqueue(repo, after: 1.hour)
        assert_nil(listener.wait_for_notify(timeout: 200.ms))
        # Rolled back: no row, no notification.
        assert_raise(RuntimeError) do
          repo.transaction do |tx|
            QtMail.enqueue(tx)
            raise "no"
          end
        end
        assert_nil(listener.wait_for_notify(timeout: 200.ms))
        assert_equal(2, count(repo))
      ensure
        listener.close
      end
    end
  end

  def test_unique
    with_repo do |repo, _|
      a = QtOnce.enqueue(repo)
      b = QtOnce.enqueue(repo, after: 1.hour)
      assert_equal([a.id, :available], [b.id, b.state])
      assert_equal(1, count(repo))
      # Another class: its own key.
      h = QtHourly.enqueue(repo)
      assert_equal(h.id, QtHourly.enqueue(repo).id)
      assert_false(row(repo, h.id)["unique_key"] == row(repo, a.id)["unique_key"])
      # Once the job is no longer live, the key is free.
      assert_equal(:cancelled, Divider.cancel(repo, a.id))
      c = QtOnce.enqueue(repo)
      assert_false(c.id == a.id)
      # A running job holds the key too.
      repo.exec("UPDATE divider_jobs SET state = 'running' WHERE id = $1", [c.id])
      d = QtOnce.enqueue(repo)
      assert_equal([c.id, :running], [d.id, d.state])
      # A failed job, whose retry is pending, too.
      repo.exec("UPDATE divider_jobs SET state = 'failed' WHERE id = $1", [c.id])
      f = QtOnce.enqueue(repo)
      assert_equal([c.id, :failed], [f.id, f.state])
      repo.exec("UPDATE divider_jobs SET state = 'completed' WHERE id = $1", [c.id])
      assert_false(QtOnce.enqueue(repo).id == c.id)
    end
  end

  def test_unique_by_arguments
    with_repo do |repo, _|
      u = Divider::Unique.new(["user_id"], nil)
      job = ->(args: String) { Divider::Queue::New.new("QtArgs", "default", args, 5, nil, nil, 20, u) }
      a = Divider::Queue.insert(repo, job.call("{\"user_id\": 1, \"template\": \"a\"}"))
      # The same user, another template: the same job.
      assert_equal(a.id, Divider::Queue.insert(repo, job.call("{\"template\": \"b\", \"user_id\": 1}")).id)
      # Another user: another job.
      b = Divider::Queue.insert(repo, job.call("{\"user_id\": 2, \"template\": \"a\"}"))
      assert_false(a.id == b.id)
      # A key differs by class.
      other = Divider::Queue.insert(repo, Divider::Queue::New.new("QtOther", "default", "{\"user_id\": 1}", 5, nil, nil, 20, u))
      assert_false(other.id == a.id)
    end
  end

  # The `n` of each job's stored arguments.
  def ns(repo: Rotor::Repo, jobs: Array[Divider::Enqueued]) -> Array[Int]
    jobs.map { |e| repo.query("SELECT (args->>'n')::int FROM divider_jobs WHERE id = $1", [e.id]) { |r| r.int(0) }[0] }
  end

  def test_enqueue_all
    with_repo do |repo, url|
      # In the order given, whatever the values.
      jobs = QtBatch.enqueue_all(repo: repo, args: [4, 0, 3, 1, 2].map { |n| QtBatch::Args.new(n) })
      assert_equal([4, 0, 3, 1, 2], ns(repo, jobs))
      assert_equal(5, jobs.map(&:id).uniq.size)
      assert_equal([:available], jobs.map(&:state).uniq)
      assert_equal([["QtBatch", "mail", 5, 20]],
                   repo.query("SELECT DISTINCT class, queue, priority, max_attempts FROM divider_jobs") { |r| [r.string(0), r.string(1), r.int(2), r.int(3)] })
      # The scheduling, the same for all.
      later = QtBatch.enqueue_all(repo: repo, args: [QtBatch::Args.new(7), QtBatch::Args.new(8)], after: 1.hour, priority: 1)
      assert_equal([:scheduled, :scheduled], later.map(&:state))
      assert_equal([1], repo.query("SELECT DISTINCT priority FROM divider_jobs WHERE id = ANY($1::bigint[])", [later.map(&:id)]) { |r| r.int(0) })
      # Nothing for an empty array.
      none: Array[QtBatch::Args] = []
      assert_equal(0, QtBatch.enqueue_all(repo: repo, args: none).size)
      assert_equal(7, count(repo))
      # What enqueue refuses (an `args:` that is no array of the arguments
      # does not compile: test/fixtures/bad_jobs).
      assert_raise(ArgumentError) { QtBatch.enqueue_all(repo: repo, args: [QtBatch::Args.new(1)], at: Time.now, after: 1.second) }
      assert_raise(ArgumentError) { QtBatch.enqueue_all(repo: repo, args: [QtBatch::Args.new(1)], priority: 10) }
      assert_equal(7, count(repo))
    end
  end

  def test_enqueue_all_unique
    with_repo do |repo, url|
      live = QtBatchOnce.enqueue(repo: repo, n: 2, tag: "before")
      jobs = QtBatchOnce.enqueue_all(repo: repo, args: [QtBatchOnce::Args.new(1, "a"), QtBatchOnce::Args.new(2, "b"),
                                                        QtBatchOnce::Args.new(5, "c"), QtBatchOnce::Args.new(5, "d"),
                                                        QtBatchOnce::Args.new(2, "e")])
      # A live job's key: that job; a key twice in the call: the first.
      assert_equal(live.id, jobs[1].id)
      assert_equal(live.id, jobs[4].id)
      assert_equal(jobs[2].id, jobs[3].id)
      assert_false(jobs[0].id == jobs[2].id)
      assert_equal(3, count(repo))
      assert_equal(["before", "a", "c"],
                   repo.query("SELECT args->>'tag' FROM divider_jobs ORDER BY id") { |r| r.string(0) })
      # Ended: a new job for its key.
      repo.exec("UPDATE divider_jobs SET state = 'completed' WHERE id = $1", [live.id])
      again = QtBatchOnce.enqueue_all(repo: repo, args: [QtBatchOnce::Args.new(2, "f")])
      assert_false(again[0].id == live.id)
      assert_equal(4, count(repo))
    end
  end

  # Equal arguments without `unique`: a job each. A role with only the
  # tables' privileges (no USAGE on the id's sequence) can enqueue_all.
  def test_enqueue_all_equal_args_and_table_privileges
    with_repo do |repo, url|
      jobs = QtBatch.enqueue_all(repo: repo, args: [QtBatch::Args.new(1), QtBatch::Args.new(1), QtBatch::Args.new(2)])
      assert_equal(3, jobs.map(&:id).uniq.size)
      assert_equal([1, 1, 2], ns(repo, jobs))
      repo.exec("DROP ROLE IF EXISTS divider_qt_app")
      repo.exec("CREATE ROLE divider_qt_app LOGIN PASSWORD 'qt-pass'")
      begin
        repo.exec("GRANT SELECT, INSERT, UPDATE, DELETE ON divider_jobs TO divider_qt_app")
        PG::Pool.open(url.sub(/\/\/[^@]*@/, "//divider_qt_app:qt-pass@"), 1) do |pool|
          app = Rotor::Repo.new(pool: pool)
          assert_equal(2, QtBatch.enqueue_all(repo: app, args: [QtBatch::Args.new(5), QtBatch::Args.new(6)]).size)
          assert_equal(2, QtBatchOnce.enqueue_all(repo: app, args: [QtBatchOnce::Args.new(5, "a"), QtBatchOnce::Args.new(5, "b")]).map(&:id).uniq.size == 1 ? 2 : 0)
          nil
        end
      ensure
        repo.exec("REVOKE ALL ON divider_jobs FROM divider_qt_app")
        repo.exec("DROP ROLE divider_qt_app")
      end
    end
  end

  def test_enqueue_all_notifies_once
    with_repo do |repo, url|
      listener = PG.connect(url)
      begin
        listener.listen("divider")
        repo.transaction do |tx|
          QtBatch.enqueue_all(repo: tx, args: (1..50).map { |n| QtBatch::Args.new(n) })
          nil
        end
        n = listener.wait_for_notify(timeout: 5.seconds)
        assert_equal("mail", n&.payload)
        assert_nil(listener.wait_for_notify(timeout: 200.ms))
        # All scheduled: none.
        QtBatch.enqueue_all(repo: repo, args: [QtBatch::Args.new(1)], after: 1.hour)
        assert_nil(listener.wait_for_notify(timeout: 200.ms))
      ensure
        listener.close
      end
    end
  end

  def test_cancel
    with_repo do |repo, _|
      a = QtPlain.enqueue(repo)
      s = QtPlain.enqueue(repo, after: 1.hour)
      assert_equal(:cancelled, Divider.cancel(repo, a.id))
      assert_nil(Divider.cancel(repo, a.id))
      assert_equal(:cancelled, Divider.cancel(repo, s.id))
      assert_equal("cancelled", row(repo, s.id)["state"])
      f = QtPlain.enqueue(repo)
      repo.exec("UPDATE divider_jobs SET state = 'failed' WHERE id = $1", [f.id])
      assert_equal(:cancelled, Divider.cancel(repo, f.id))
      r = QtPlain.enqueue(repo)
      repo.exec("UPDATE divider_jobs SET state = 'running' WHERE id = $1", [r.id])
      assert_equal(:requested, Divider.cancel(repo, r.id))
      assert_equal("running", row(repo, r.id)["state"])
      first = repo.query("SELECT cancelled_at FROM divider_jobs WHERE id = $1", [r.id]) { |x| x.time(0) }[0]
      # Asked again: requested again, the first request's time kept.
      assert_equal(:requested, Divider.cancel(repo, r.id))
      assert_equal(first, repo.query("SELECT cancelled_at FROM divider_jobs WHERE id = $1", [r.id]) { |x| x.time(0) }[0])
      c = QtPlain.enqueue(repo)
      repo.exec("UPDATE divider_jobs SET state = 'completed' WHERE id = $1", [c.id])
      assert_nil(Divider.cancel(repo, c.id))
      assert_nil(Divider.cancel(repo, 999_999))
    end
  end
end
