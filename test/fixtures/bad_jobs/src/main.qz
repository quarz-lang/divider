class Pen
  @ink: Int = 0
end

data Good = (user_id: Int, template: String = "welcome")
data Empty = ()
data Named = (priority: Int)
data Holding = (pen: Pen)
data Deep = (inner: Holding)

class BadQueue < Divider::Job
  queue :"no-dash"
end

class BadAttempts < Divider::Job
  max_attempts 0
end

class BadTimeout < Divider::Job
  timeout 0.seconds
end

class NoFields < Divider::Job
  job_args Empty
end

class ReservedName < Divider::Job
  job_args Named
end

class NotEncodable < Divider::Job
  job_args Holding
end

class NestedNotEncodable < Divider::Job
  job_args Deep
end

class Twice < GoodBase
  job_args Good
  job_args Good
end

class UniqueUnknown < GoodBase
  job_args Good
  unique by: [:user]
end

class UniqueDefaulted < GoodBase
  job_args Good
  unique by: [:template]
end

class UniqueFirst < GoodBase
  unique by: [:user_id]
  job_args Good
end

class Fine < GoodBase
  job_args Good
end

def calls(repo: Rotor::Repo) -> Void
  Fine.enqueue(repo: repo, user_id: "1")
  Fine.enqueue(repo: repo, user_id: 1, colour: "red")
  Fine.enqueue_args(repo: repo, args: 3)
  Fine.enqueue_all(repo: repo, args: "not an array")
  Fine.enqueue_all(repo: repo, args: [Other.new(1)])
  Typed.enqueue(repo: repo, ids: ["x"])
  Typed.enqueue(repo: repo, ids: [1], note: 3)
end


# (The `perform(args, job)` of the classes above that declare `Good`.)
class GoodBase < Divider::Job
  def perform(args: Good, job: Divider::Context) -> Void
  end
end

data Other = (x: Int)

class NoPerform < Divider::Job
  job_args Good
end

class Redeclared < Fine
  job_args Other

  def perform(args: Other, job: Divider::Context) -> Void
  end
end

# Fields whose types have type arguments, or a nil (divider#33).
data TypedArgs = (ids: Array[Int], note: String? = nil, counts: Hash[String, Int] = {})

class Typed < GoodBase2
  job_args TypedArgs
end

class GoodBase2 < Divider::Job
  def perform(args: TypedArgs, job: Divider::Context) -> Void
  end
end

# A factory whose block gives another job class (divider#38).
def factories -> Array[Divider::Factory]
  [Divider.factory(Fine) { NoPerform.new }]
end

class NeedsTwice < Divider::Job
  needs_factory
  needs_factory
end

# An `initialize` that requires a block and no `needs_factory`: the hook
# cannot tell it from one taking nothing, and the checker refuses it, as
# `new_job` calls `new` without a block.
class BlockInit < Divider::Job
  @tag: String

  def initialize(&make: () -> String)
    @tag = make.call
  end
end

# divider#8: in the keyword form, nil for a field that is not nullable
# and a required field left out are compile errors, as in `enqueue_args`.
def more_calls(repo: Rotor::Repo) -> Void
  Fine.enqueue(repo: repo, user_id: nil)
  Typed.enqueue(repo: repo, note: "x")
  Typed.enqueue(repo: repo, ids: [1], counts: {"a" => "b"})
end

# divider#50: an args type with type parameters is refused at
# `job_args`; a field of a generic type with its arguments written is
# fine. (An alias, `type IntBox = Boxed[Int]`, cannot be given at all:
# quarz refuses a type alias as a value.)
data Boxed[T] = (v: T, label: String)
data Pairs[K, V] = (keys: Array[K], values: Hash[String, V?])
data Phantom[T] = (label: String)
data Inner[T] = (x: T)
data Nested = (inner: Inner[Int], ids: Array[Int])

class BoxJob < Divider::Job
  job_args Boxed[Int]
end

class PairsJob < Divider::Job
  job_args Pairs[Int, String]
end

class PhantomJob < Divider::Job
  job_args Phantom[Int]
end

class NestedJob < Divider::Job
  job_args Nested
  def perform(args: Nested, job: Divider::Context) -> Void
  end
end
