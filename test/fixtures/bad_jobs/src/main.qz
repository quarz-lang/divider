class Pen
  @ink: Int = 0
end

data Good = (user_id: Int, template: String = "welcome")
data Empty = ()
data Named = (priority: Int)
data Holding = (pen: Pen)
data Deep = (inner: Holding)

class BadQueue < Divider::Job
  queue :"no-dash"
end

class BadAttempts < Divider::Job
  max_attempts 0
end

class BadTimeout < Divider::Job
  timeout 0.seconds
end

class NoFields < Divider::Job
  job_args Empty
end

class ReservedName < Divider::Job
  job_args Named
end

class NotEncodable < Divider::Job
  job_args Holding
end

class NestedNotEncodable < Divider::Job
  job_args Deep
end

class Twice < GoodBase
  job_args Good
  job_args Good
end

class UniqueUnknown < GoodBase
  job_args Good
  unique by: [:user]
end

class UniqueDefaulted < GoodBase
  job_args Good
  unique by: [:template]
end

class UniqueFirst < GoodBase
  unique by: [:user_id]
  job_args Good
end

class Fine < GoodBase
  job_args Good
end

def calls(repo: Rotor::Repo) -> Void
  Fine.enqueue(repo: repo, user_id: "1")
  Fine.enqueue(repo: repo, user_id: 1, colour: "red")
  Fine.enqueue_args(repo: repo, args: 3)
end

# (The `perform(args, job)` of the classes above that declare `Good`.)
class GoodBase < Divider::Job
  def perform(args: Good, job: Divider::Context) -> Void
  end
end

data Other = (x: Int)

class NoPerform < Divider::Job
  job_args Good
end

class Redeclared < Fine
  job_args Other

  def perform(args: Other, job: Divider::Context) -> Void
  end
end
