# Run by test/args_test.qz (`quarz run`): raises on the first check that
# fails, prints "ok" at the end.
def check(cond: Bool, what: String) -> Void
  raise "failed: #{what}" unless cond
end

def args_of(repo: Rotor::Repo, id: Int) -> String
  repo.query("SELECT args::text FROM divider_jobs WHERE id = $1", [id]) { |r| r.string(0) }[0]
end

def run(repo: Rotor::Repo) -> Void
  check(Welcome.job_args_type == WelcomeArgs, "job_args_type")
  check(Welcome.job_unique == Divider::Unique.new(["user_id"], nil), "job_unique")
  # The keyword form encodes the arguments given (the defaults are the
  # decoder's), as JSON.
  a = Welcome.enqueue(repo: repo, user_id: 1)
  check(a.state == :available, "available")
  check(args_of(repo, a.id) == "{\"user_id\": 1}", "the arguments given: #{args_of(repo, a.id)}")
  b = Welcome.enqueue(repo: repo, user_id: 2, note: nil, kind: :sms, inner: Inner.new(["x", "y"], true),
                      after: 1.hour, priority: 1)
  check(b.state == :scheduled, "scheduled")
  check(args_of(repo, b.id) == "{\"kind\": \"sms\", \"note\": null, \"inner\": {\"seen\": true, \"tags\": [\"x\", \"y\"]}, \"user_id\": 2}",
        "nested, nullable, symbol: #{args_of(repo, b.id)}")
  check(repo.query("SELECT queue, priority FROM divider_jobs WHERE id = $1", [b.id]) { |r| "#{r.string(0)} #{r.int(1)}" }[0] == "mail 1",
        "queue and priority")
  # `enqueue_args` encodes every field.
  e = Welcome.enqueue_args(repo: repo, args: WelcomeArgs.new(3, "bye"))
  check(args_of(repo, e.id) == "{\"kind\": \"mail\", \"note\": null, \"inner\": null, \"user_id\": 3, \"template\": \"bye\"}",
        "enqueue_args: #{args_of(repo, e.id)}")
  # The inherited form, without the arguments: refused.
  refused = begin
    Welcome.enqueue(repo: repo)
    false
  rescue ArgumentError
    true
  end
  check(refused, "enqueue without the arguments")
  check(repo.query("SELECT count(*) FROM divider_jobs WHERE args = '{}'::jsonb") { |r| r.int(0) }[0] == 0, "nothing inserted")
  # Unique by user_id, whichever form.
  u = Welcome.enqueue(repo: repo, user_id: 7)
  check(Welcome.enqueue(repo: repo, user_id: 7, template: "other").id == u.id, "unique, keywords")
  check(Welcome.enqueue_args(repo: repo, args: WelcomeArgs.new(7)).id == u.id, "unique, enqueue_args")
  check(Welcome.enqueue(repo: repo, user_id: 8).id != u.id, "another user")
  # Run: each decodes its arguments, defaults filling what the row does
  # not hold. (`b` is due in an hour: not run.)
  repo.exec("CREATE TABLE welcome_runs (job_id bigint PRIMARY KEY, args text NOT NULL)")
  ran = Divider::Testing.drain(repo, jobs: [Welcome])
  check(ran == 4, "drained #{ran}")
  check(run_of(repo, a.id) == WelcomeArgs.new(1).inspect, "decoded with defaults: #{run_of(repo, a.id)}")
  e = Welcome.enqueue_args(repo: repo, args: WelcomeArgs.new(3, "bye", "n", Inner.new(["t"], false), :sms))
  Divider::Testing.drain(repo, jobs: [Welcome])
  check(run_of(repo, e.id) == WelcomeArgs.new(3, "bye", "n", Inner.new(["t"], false), :sms).inspect, "decoded: #{run_of(repo, e.id)}")
  # Every kind of field round-trips.
  all = AllArgs.new(1, 2.5, "s", true, Time.utc(2026, 11, 8, 1, 2, 3) + 456.ms, Bytes[0, 255, 7], :sym, nil, [1, 2],
                    {"k" => 3}, Set["a", "b"], Inner.new(["x"], true))
  t = AllTypes.enqueue_args(repo: repo, args: all)
  Divider::Testing.drain(repo, jobs: [AllTypes])
  check(run_of(repo, t.id) == all.inspect, "every type: #{run_of(repo, t.id)} vs #{all.inspect}")
  # Arguments that no longer fit the class (a deploy changed it):
  # discarded, not retried, the error naming where.
  repo.exec("INSERT INTO divider_jobs (class, queue, args) VALUES ('Welcome', 'mail', '{\"user_id\": \"x\"}')")
  bad = repo.query("SELECT max(id) FROM divider_jobs") { |r| r.int(0) }[0]
  Divider::Testing.drain(repo, jobs: [Welcome])
  row = repo.query("SELECT state, attempt, errors->0->>'error', errors->0->>'message' FROM divider_jobs WHERE id = $1", [bad]) do |r|
    [r.string(0), r.int(1).to_s, r.string(2), r.string(3)]
  end[0]
  check(row[0] == "discarded" && row[1] == "1" && row[2] == "Divider::ArgsError", "mismatch discarded: #{row.inspect}")
  check(row[3].include?("WelcomeArgs") && row[3].include?("user_id"), "the message names the type and the field: #{row[3]}")
end

def run_of(repo: Rotor::Repo, id: Int) -> String
  found = repo.query("SELECT args FROM welcome_runs WHERE job_id = $1", [id]) { |r| r.string(0) }
  found.first? || "(not run)"
end

begin
  PG::Testing.with_cluster do |url|
    PG::Pool.open(url, 1) do |pool|
      repo = Rotor::Repo.new(pool: pool)
      repo.exec("DROP TABLE IF EXISTS divider_jobs, divider_cron, divider_args_versions, welcome_runs")
      begin
        Rotor::Migrator.new(repo, Divider::Migrations.all, table: "divider_args_versions").migrate
        run(repo)
      ensure
        repo.exec("DROP TABLE IF EXISTS divider_jobs, divider_cron, divider_args_versions, welcome_runs")
      end
    end
  end
  puts "ok"
rescue PG::Testing::Unavailable => e
  puts "unavailable: #{e.message}"
end
