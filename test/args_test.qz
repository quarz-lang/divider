require "test"

# Jobs' statements checked at compile time (test/fixtures/bad_jobs), and
# jobs with arguments (test/fixtures/args_jobs, a program run here):
# fixtures, checked by `quarz` on the PATH or by $QUARZ (the errors are
# compile errors, and the program needs a server).
class ArgsTest < Test::Case
  def quarz(dir: String, command: String) -> Process::Output
    Process.sh("cd test/fixtures/#{dir} && exec \"${QUARZ:-quarz}\" #{command} 2>&1")
  end

  def test_statements_are_checked_at_compile_time
    out = quarz("bad_jobs", "check")
    assert(!out.success?)
    text = out.stdout
    assert_match(/main\.qz:12:3: error: `queue` raised ArgumentError: a queue's name is letters, digits and _, not "no-dash"/, text)
    assert_match(/main\.qz:16:3: error: `max_attempts` raised ArgumentError: max_attempts is 1 or more, not 0/, text)
    assert_match(/main\.qz:20:3: error: `timeout` raised ArgumentError: a timeout is at least 1ms, not 0s/, text)
    assert_match(/main\.qz:55:3: error: `unique` raised ArgumentError: unique by: UniqueFirst has no argument user_id \(`job_args` comes first\)/, text)
    assert_match(/main\.qz:24:3: error: `job_args` raised ArgumentError: Empty has no fields/, text)
    assert_match(/main\.qz:28:3: error: `job_args` raised ArgumentError: Named#priority: a job's argument cannot be named priority/, text)
    assert_match(/main\.qz:32:3: error: `job_args` raised ArgumentError: Holding#pen: a Pen cannot be a job's argument/, text)
    assert_match(/main\.qz:36:3: error: `job_args` raised ArgumentError: Deep#inner\.pen: a Pen cannot be a job's argument/, text)
    assert_match(/main\.qz:41:3: error: `job_args` raised ArgumentError: Twice declares `job_args` twice/, text)
    assert_match(/main\.qz:46:3: error: `unique` raised ArgumentError: unique by: UniqueUnknown has no argument user/, text)
    assert_match(/main\.qz:51:3: error: `unique` raised ArgumentError: unique by: the argument template has a default/, text)
    # The calls: a keyword of the wrong class, an unknown one, and
    # `enqueue_args` with something else than the job's `Args`. (Without
    # the arguments, `enqueue(repo: repo)` is the inherited form, which
    # raises: test/fixtures/args_jobs.)
    assert_match(/main\.qz:64:3: error: no overload of `enqueue` on Type\[Fine\] matches \(repo: Rotor::Repo, user_id: String\)/, text)
    assert_match(/main\.qz:65:3: error: no overload of `enqueue` on Type\[Fine\] matches \(repo: Rotor::Repo, user_id: .*, colour: String\)/, text)
    assert_match(/main\.qz:66:39: error: argument `args` of enqueue_args\(.*\) -> Divider::Enqueued expects Good but found Int/, text)
    # divider#33: `enqueue_all`'s `args:` is an `Array` of the args
    # type, and a field's keyword has the field's type in full.
    assert_match(/main\.qz:67:38: error: argument `args` of enqueue_all\(.*args: Array\[Good\].*\) -> Array\[Divider::Enqueued\] expects Array\[Good\] but found String/, text)
    assert_match(/main\.qz:68:38: error: array elements have type Other but Good was expected/, text)
    assert_match(/main\.qz:69:3: error: no overload of `enqueue` on Type\[Typed\] matches/, text)
    assert_match(/enqueue\(repo: Rotor::Repo, ids: Array\[Int\], note: String\? = \.\.\., counts: Hash\[String, Int\] = \.\.\..*: array elements have type String but Int was expected/, text)
    assert_match(/main\.qz:70:3: error: no overload of `enqueue` on Type\[Typed\] matches/, text)
    assert_match(/argument `note` of enqueue\(.*\) -> Divider::Enqueued expects String\? but found Int/, text)
    # divider#8: nil for a field that is not nullable, a required field
    # left out, and a hash of the wrong value type, in the keyword form.
    assert_match(/main\.qz:129:3: error: no overload of `enqueue` on Type\[Fine\] matches/, text)
    assert_match(/argument `user_id` of enqueue\(.*\) -> Divider::Enqueued expects Int but found Nil/, text)
    assert_match(/main\.qz:130:3: error: no overload of `enqueue` on Type\[Typed\] matches/, text)
    assert_match(/enqueue\(repo: Rotor::Repo, ids: Array\[Int\], .*\) -> Divider::Enqueued is missing the argument `ids`/, text)
    assert_match(/main\.qz:131:3: error: no overload of `enqueue` on Type\[Typed\] matches/, text)
    assert_match(/hash has type Hash\[String, String\] but Hash\[String, Int\] was expected/, text)
    # divider#50: an args type with type parameters is refused at
    # `job_args`, naming the job, the type and its parameters; one whose
    # parameter no field mentions is refused by quarz at `enqueue_args`;
    # a field of a generic type with its arguments written is fine.
    assert_match(/main\.qz:145:3: error: `job_args` raised ArgumentError: BoxJob: the args type Boxed has type parameters \(T\), which a job's arguments cannot have: write a data type with the fields' types spelled out/, text)
    assert_match(/main\.qz:149:3: error: `job_args` raised ArgumentError: PairsJob: the args type Pairs has type parameters \(K, V\)/, text)
    assert_match(/main\.qz:153:3: error: `def_class_method\(:enqueue_args\)`: the keyword `args` is typed `Phantom`, which takes type arguments/, text)
    refute_match(/main\.qz:15[6-9]:\d+: error/, text)
    # A job of arguments without `perform(args, job)`, and a subclass of
    # one declaring others.
    assert_match(/main\.qz:83:3: error: `method_ref\(:perform\)`: the handle to `NoPerform#perform` is a `Meta::Method\[NoPerform, \(Good, Divider::Context\) -> Void\]`, but `NoPerform` has no method `perform` of that type/, text)
    assert_match(/main\.qz:87:3: error: `job_args` raised ArgumentError: Redeclared inherits the arguments of a job with `job_args`: a subclass cannot declare others/, text)
    # (`Fine` and the others that declare `Good` are refused at nothing
    # else: their `perform` is GoodBase's.)
    refute_match(/main\.qz:(40|45|50|56|60):3: error: `method_ref/, text)
    # divider#38: a factory's block gives an instance of its class.
    assert_match(/main\.qz:107:28: error: block returns NoPerform but Fine was expected/, text)
    assert_match(/main\.qz:112:3: error: `needs_factory` raised ArgumentError: NeedsTwice declares `needs_factory` twice/, text)
    # A block-requiring `initialize` without `needs_factory`: `new_job`
    # calls `new` without a block (quarz-lang/quarz#1065).
    assert_match(/main\.qz:121:3: error: `BlockInit#initialize` does not take the arguments of `new` in `Divider::Job\.new_job`, which `BlockInit` inherits/, text)
  end

  def test_jobs_with_arguments
    out = quarz("args_jobs", "run")
    unavailable = out.stdout.lines.find { |l| l.start_with?("unavailable: ") }
    omit(unavailable.strip) if unavailable
    assert(out.success?, out.stdout)
    assert_equal("ok", out.stdout.lines.last?&.strip)
  end
end
