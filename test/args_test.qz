require "test"

# Jobs' statements checked at compile time (test/fixtures/bad_jobs), and
# jobs with arguments (test/fixtures/args_jobs, a program run here):
# fixtures, checked by `quarz` on the PATH or by $QUARZ, so that this
# suite compiles while quarz-lang/quarz#397 refuses every `args`
# statement (its generated `enqueue` inserts, which the statement's
# compile-time reach counts).
class ArgsTest < Test::Case
  BLOCKED = /`args` reaches .* which cannot run at compile time/

  def quarz(dir: String, command: String) -> Process::Output
    Process.sh("cd test/fixtures/#{dir} && exec \"${QUARZ:-quarz}\" #{command} 2>&1")
  end

  def test_statements_are_checked_at_compile_time
    out = quarz("bad_jobs", "check")
    assert(!out.success?)
    text = out.stdout
    assert_match(/main\.qz:12:3: error: `queue` raised ArgumentError: a queue's name is letters, digits and _, not "no-dash"/, text)
    assert_match(/main\.qz:16:3: error: `max_attempts` raised ArgumentError: max_attempts is 1 or more, not 0/, text)
    assert_match(/main\.qz:20:3: error: `timeout` raised ArgumentError: a timeout is at least 1ms, not 0s/, text)
    assert_match(/main\.qz:55:3: error: `unique` raised ArgumentError: unique by: UniqueFirst has no argument user_id \(`args` comes first\)/, text)
    omit("quarz-lang/quarz#397: `args` statements are refused at compile time") if text.match?(BLOCKED)
    assert_match(/main\.qz:24:3: error: `args` raised ArgumentError: Empty has no fields/, text)
    assert_match(/main\.qz:28:3: error: `args` raised ArgumentError: Named#priority: a job's argument cannot be named priority/, text)
    assert_match(/main\.qz:32:3: error: `args` raised ArgumentError: Holding#pen: a Pen cannot be a job's argument/, text)
    assert_match(/main\.qz:36:3: error: `args` raised ArgumentError: Deep#inner\.pen: a Pen cannot be a job's argument/, text)
    assert_match(/main\.qz:41:3: error: `args` raised ArgumentError: Twice declares `args` twice/, text)
    assert_match(/main\.qz:46:3: error: `unique` raised ArgumentError: unique by: UniqueUnknown has no argument user/, text)
    assert_match(/main\.qz:51:3: error: `unique` raised ArgumentError: unique by: the argument template has a default/, text)
    # The calls: a keyword of the wrong class, an unknown one, and
    # `enqueue_args` with something else than the job's `Args`. (Without
    # the arguments, `enqueue(repo: repo)` is the inherited form, which
    # raises: test/fixtures/args_jobs.)
    assert_match(/main\.qz:64:3: error: no overload of `enqueue` on Type\[Fine\] matches \(repo: Rotor::Repo, user_id: String\)/, text)
    assert_match(/main\.qz:65:3: error: no overload of `enqueue` on Type\[Fine\] matches \(repo: Rotor::Repo, user_id: .*, colour: String\)/, text)
    assert_match(/main\.qz:66:39: error: argument `args` of enqueue_args\(.*\) -> Divider::Enqueued expects Good but found Int/, text)
  end

  def test_jobs_with_arguments
    out = quarz("args_jobs", "run")
    omit("quarz-lang/quarz#397: `args` statements are refused at compile time") if out.stdout.match?(BLOCKED)
    unavailable = out.stdout.lines.find { |l| l.start_with?("unavailable: ") }
    omit(unavailable.strip) if unavailable
    assert(out.success?, out.stdout)
    assert_equal("ok", out.stdout.lines.last?&.strip)
  end
end
